{
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*",                    "destination": "/api/:path*" },
    { "source": "/assets/:path*",                 "destination": "/assets/:path*" },
    { "source": "/sw.js",                         "destination": "/sw.js" },
    { "source": "/manifest.json",                 "destination": "/manifest.json" },
    { "source": "/blackthorn-logo.png",           "destination": "/blackthorn-logo.png" },
    { "source": "/favicon.svg",                   "destination": "/favicon.svg" },
    { "source": "/fine-line-tattoo-mallorca",     "destination": "/fine-line-tattoo-mallorca.html" },
    { "source": "/tattoo-studio-south-mallorca",  "destination": "/tattoo-studio-south-mallorca.html" },
    { "source": "/tatouage-majorque",             "destination": "/tatouage-majorque.html" },
    { "source": "/tattoo-mallorca-urlaub",        "destination": "/tattoo-mallorca-urlaub.html" },
    { "source": "/realism-tattoo-mallorca",       "destination": "/realism-tattoo-mallorca.html" },
    { "source": "/(.*)",                          "destination": "/index.html" }
  ]
}
