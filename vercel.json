{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/fine-line-tattoo-mallorca", "destination": "/fine-line-tattoo-mallorca.html" },
    { "source": "/tattoo-studio-south-mallorca", "destination": "/tattoo-studio-south-mallorca.html" },
    { "source": "/tatouage-majorque", "destination": "/tatouage-majorque.html" },
    { "source": "/tattoo-mallorca-urlaub", "destination": "/tattoo-mallorca-urlaub.html" },
    { "source": "/realism-tattoo-mallorca", "destination": "/realism-tattoo-mallorca.html" }
  ]
}